<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page draws its own header. The window background
         matches the page so there is no flash while the WebView starts. -->
    <style name="Theme.Pantry" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pantry_cream</item>
        <item name="android:statusBarColor">@color/pantry_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/pantry_cream</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
